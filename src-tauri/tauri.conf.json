{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paste-boss",
  "version": "0.2.0",
  "identifier": "com.tauri-app.paste-boss",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paste-boss",
        "width": 800,
        "height": 600,
        "minWidth": 420,
        "minHeight": 320,
        "visible": false,
        "alwaysOnTop": true,
        "center": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
